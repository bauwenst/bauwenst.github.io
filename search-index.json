---
layout: null
permalink: /assets/search-index.json
---
[
{%- assign truncate_len = site.site_search.content_truncate -%}
{%- for post in site.posts -%}
  {%- assign body = post.content | strip_html | normalize_whitespace -%}
  {%- if truncate_len and truncate_len > 0 -%}
    {%- assign body = body | truncate: truncate_len, "" -%}
  {%- endif -%}
  {
    "title": {{ post.title | jsonify }},
    "url": {{ post.url | relative_url | jsonify }},
    "date": {{ post.date | date: "%Y-%m-%d" | jsonify }},
    "description": {{ post.description | default: "" | strip_html | normalize_whitespace | jsonify }},
    "content": {{ body | jsonify }}
  }{%- unless forloop.last -%},{%- endunless -%}
{%- endfor -%}
]
